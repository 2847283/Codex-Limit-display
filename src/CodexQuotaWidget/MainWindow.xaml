<Window x:Class="CodexQuotaWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:CodexQuotaWidget.ViewModels"
        mc:Ignorable="d"
        Title="Codex 额度"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="False"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.ContextMenu>
        <ContextMenu Background="#FF242424"
                     BorderBrush="#FF3A3A3A"
                     Foreground="#FFF1F1F1">
            <MenuItem x:Name="ScanNowMenuItem" Header="立即扫描" Click="ScanNow_Click" />
            <MenuItem x:Name="ExitMenuItem" Header="退出" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border Margin="10"
            Padding="18"
            CornerRadius="14"
            Background="#E61A1A1A"
            BorderBrush="#FF303030"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="3"
                              Direction="270"
                              Opacity="0.38"
                              Color="#FF000000" />
        </Border.Effect>

        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CODEX LIMITS"
                               Foreground="#FFF4F4F4"
                               FontFamily="Segoe UI Semibold"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding PlanText}"
                               Foreground="#FF8D8D8D"
                               FontSize="11" />
                </StackPanel>
                <Border Grid.Column="1"
                        Width="30"
                        Height="30"
                        CornerRadius="8"
                        Background="#FF242424">
                    <TextBlock Text="C"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#FFD7FF64"
                               FontSize="15"
                               FontWeight="Bold" />
                </Border>
            </Grid>

            <Border Margin="0,16,0,0"
                    Height="1"
                    Background="#FF303030" />

            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Windows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:QuotaWindowViewModel}">
                        <StackPanel Margin="0,14,0,0">
                            <Grid>
                                <TextBlock Text="{Binding Label}"
                                           Foreground="#FFB8B8B8"
                                           FontSize="12" />
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding RemainingText}"
                                           Foreground="#FFF4F4F4"
                                           FontFamily="Segoe UI Semibold"
                                           FontSize="24"
                                           FontWeight="SemiBold" />
                            </Grid>
                            <ProgressBar Margin="0,7,0,0"
                                         Height="6"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding RemainingPercent, Mode=OneWay}"
                                         Background="#FF303030"
                                         BorderThickness="0">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Foreground" Value="#FFD7FF64" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFF5D5D" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Margin="0,7,0,0"
                                       Text="{Binding ResetText}"
                                       Foreground="#FF777777"
                                       FontSize="11" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Margin="0,16,0,0"
                    Padding="10,8"
                    CornerRadius="8"
                    Background="#FF242424">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="7"
                             Height="7"
                             Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#FF888888" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static viewModels:QuotaStatusTone.Current}">
                                        <Setter Property="Fill" Value="#FF73D68A" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static viewModels:QuotaStatusTone.Critical}">
                                        <Setter Property="Fill" Value="#FFFF5D5D" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#FFB0B0B0"
                               FontSize="11" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
